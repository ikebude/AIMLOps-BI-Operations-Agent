# BI Operations Agent — Environment Configuration
# Default provider is "semantic" (deterministic Semantic Pattern Compiler, no API key required)
BI_AGENT_PROVIDER=semantic

# Optional external LLM provider keys (set BI_AGENT_PROVIDER=anthropic | openai | ollama)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
